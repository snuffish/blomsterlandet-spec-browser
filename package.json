{
  "name": "blomsterlandet-spec-browser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "harvest": "tsx harvest/build.ts",
    "harvest:fresh": "tsx harvest/build.ts --no-cache",
